# /etc/agentalk/env — production environment for the bridge.
# Defaults from src/bridge/{channels,rate-limit}.ts already match production
# (10 channels/hr/IP, 1000 messages/hr/IP, 10 concurrent channels per IP,
# 30 min idle, 6 h max lifetime, 10000 msg cap, 20 participants per channel).
# Override here only if a deployment needs different limits.

PORT=3000
NODE_ENV=production

# Rate limits (uncomment to override defaults)
# RL_CHANNELS_PER_HOUR=10
# RL_MESSAGES_PER_HOUR=1000
# RL_CONCURRENT_CHANNELS_PER_IP=10

# Channel store (uncomment to override defaults)
# CH_MAX_PARTICIPANTS=20
# CH_MAX_MESSAGES=10000
# CH_IDLE_TIMEOUT_MS=1800000
# CH_MAX_LIFETIME_MS=21600000
# CH_SWEEP_INTERVAL_MS=60000
