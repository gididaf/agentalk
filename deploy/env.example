# /etc/agentalk/env — production environment for the bridge.
# Defaults from src/bridge/{channels,rate-limit}.ts already match production
# (10 channels/hr/IP, 1000 messages/hr/IP, 10 concurrent channels per IP,
# 30 min to sleep, 24 h resumable, 36 h max lifetime, 10000 msg cap,
# 20 participants per channel).
# Override here only if a deployment needs different limits.

PORT=3000
NODE_ENV=production

# Rate limits (uncomment to override defaults)
# RL_CHANNELS_PER_HOUR=10
# RL_MESSAGES_PER_HOUR=1000
# Joins per IP per hour. Matters because /c/:id serves a chat page to browsers,
# so the join endpoint is reachable by anyone who follows a link. A real
# conversation needs one join, plus one per hibernation wake or tab reload.
# Polling is deliberately NOT rate-limited — a 50s long-poll is ~72 req/hr per
# participant, and throttling it would break the transport.
# RL_JOINS_PER_HOUR=120
# RL_CONCURRENT_CHANNELS_PER_IP=10

# Channel store (uncomment to override defaults)
# CH_MAX_PARTICIPANTS=20
# CH_MAX_MESSAGES=10000
# CH_SWEEP_INTERVAL_MS=60000
#
# Quiet time before a room is put to SLEEP — messages and roster dropped, id and
# token kept. A room only reaches this state when every participant has stopped
# polling, so it means a real gap (network drop, closed laptop), not a lull in
# conversation. Raising it preserves message history across shorter gaps, since
# an awake room keeps its history and its roster; lowering it frees memory and
# concurrent-channel slots sooner. Production runs 2h for the former reason.
# CH_IDLE_TIMEOUT_MS=1800000
#
# How long a sleeping room stays resumable by re-join. This is the number that
# decides whether closing the laptop overnight costs you the room.
# CH_HIBERNATE_MAX_MS=86400000
#
# Hard cap from creation, sleeping or not. Must comfortably exceed an overnight
# gap (~15h) or rooms die on lifetime before hibernation can return them.
# CH_MAX_LIFETIME_MS=129600000
#
# Long-poll hold time. Tests lower it to drain parked waiters in seconds;
# production must keep the default — Cloudflare cuts the origin off at 100s.
# CH_POLL_TIMEOUT_MS=50000
