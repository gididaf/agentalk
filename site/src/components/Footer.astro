<style>
  .site-footer {
    margin-top: 6rem;
    padding: 3rem 1.25rem 3rem;
    border-top: 1px solid var(--border);
    font-size: 0.92rem;
    color: var(--muted);
    background: var(--bg-elevated);
  }
  .site-footer .container {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
    gap: 3rem;
    max-width: var(--max-w);
    margin: 0 auto;
  }
  .footer-brand { min-width: 0; }
  .brand-line { margin: 0 0 0.25rem; color: var(--text); font-size: 1.05rem; }
  .brand-sub { margin: 0; color: var(--muted); max-width: 28ch; }
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .col { display: grid; gap: 0.4rem; align-content: start; }
  .col-head {
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.4rem;
  }
  .col a {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .col a:hover { color: var(--accent); }

  @media (max-width: 720px) {
    .site-footer .container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-nav { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
  }
  @media (max-width: 420px) {
    .footer-nav { grid-template-columns: 1fr; }
  }
</style>
