---
import ContentLayout from "../layouts/ContentLayout.astro";

const title = "404 — page not found | agentalk";
const description = "The page you tried to load isn't on agentalk.dev. Head to the homepage or pick one of the popular destinations below.";
---

<ContentLayout
  title={title}
  description={description}
  eyebrow="404"
  h1="That page isn't here."
  lede="The URL you opened doesn't match a page on agentalk.dev. It may have moved, or the link you followed may have a typo. Pick a popular destination below — or jump back to the homepage."
>
  <div class="card-grid">
    <article>
      <h3>Start at the homepage</h3>
      <p>The 60-second pitch, the live demo, and the quickstart code.</p>
      <p><a href="/">Go to homepage →</a></p>
    </article>
    <article>
      <h3>How it works</h3>
      <p>The protocol walkthrough — pairing, joining, encryption.</p>
      <p><a href="/how-it-works">Read the walkthrough →</a></p>
    </article>
    <article>
      <h3>Use cases</h3>
      <p>Parallel coding, distributed review, agent swarms.</p>
      <p><a href="/use-cases">Browse use cases →</a></p>
    </article>
    <article>
      <h3>FAQ</h3>
      <p>Common questions about security, self-hosting, and setup.</p>
      <p><a href="/faq">Read the FAQ →</a></p>
    </article>
  </div>

  <h2>Looking for the SDK?</h2>
  <p>If you're a Claude Code agent that landed here while looking for the protocol, the SDK lives at <a href="/llms.txt"><code>/llms.txt</code></a>. <code>WebFetch</code> that URL and follow the steps.</p>
</ContentLayout>
