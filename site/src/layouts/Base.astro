---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, canonical, ogImage = "/og.png", jsonLd } = Astro.props;
// trailingSlash: "never" is the site-wide policy (see astro.config.mjs and the
// sitemap output). new URL("/", site) auto-appends "/" on the root, so strip
// the trailing slash here too — keeps canonical, og:url, and sitemap aligned.
const canonicalUrl = (canonical ?? new URL(Astro.url.pathname, Astro.site).href).replace(/\/$/, "");
const ogImageUrl = new URL(ogImage, Astro.site).href;
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const gscVerify = import.meta.env.PUBLIC_GSC_VERIFY;
const bingVerify = import.meta.env.PUBLIC_BING_VERIFY;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM-first SDK (the protocol agents follow)" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#0d9488" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="agentalk" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="agentalk — agent-to-agent HTTP bridge for Claude Code" />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{gscVerify && <meta name="google-site-verification" content={gscVerify} />}
{bingVerify && <meta name="msvalidate.01" content={bingVerify} />}

{jsonLdList.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

{ga4Id && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ga4Id, { anonymize_ip: true });
    </script>
  </>
)}

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --bg-elevated: #f8fafc;
    --text: #0f172a;
    --muted: #64748b;
    --border: #e2e8f0;
    --code-bg: #f1f5f9;
    --accent: #0d9488;
    --accent-hover: #0f766e;
    --accent-soft: rgba(13, 148, 136, 0.08);
    --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04);
    --shadow-md: 0 4px 14px rgba(15, 23, 42, 0.06);
    --radius: 8px;
    --max-w: 64rem;
    --content-w: 44rem;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0a0a0a;
      --bg-elevated: #111417;
      --text: #e8eaed;
      --muted: #94a3b8;
      --border: #1f2937;
      --code-bg: #141414;
      --accent: #2dd4bf;
      --accent-hover: #5eead4;
      --accent-soft: rgba(45, 212, 191, 0.10);
      --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
      --shadow-md: 0 4px 14px rgba(0, 0, 0, 0.5);
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font: 16px/1.6 -apple-system, system-ui, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--text);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  main { max-width: var(--max-w); margin: 0 auto; padding: 0 1.25rem; }
  .container { max-width: var(--content-w); margin: 0 auto; }
  h1, h2, h3 { line-height: 1.2; margin: 0 0 0.5rem; letter-spacing: -0.01em; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; letter-spacing: -0.02em; }
  h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 600; margin-top: 4rem; }
  h3 { font-size: 1.125rem; font-weight: 600; }
  p { margin: 0 0 1rem; }
  a { color: var(--accent); text-decoration: none; transition: color 120ms; }
  a:hover { color: var(--accent-hover); text-decoration: underline; }
  code {
    background: var(--code-bg);
    padding: 0.12em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }
  pre {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  pre code { background: transparent; padding: 0; font-size: inherit; }
  strong { color: var(--text); font-weight: 600; }
  hr { border: 0; border-top: 1px solid var(--border); margin: 3rem 0; }
</style>
</head>
<body>
<slot />
</body>
</html>
