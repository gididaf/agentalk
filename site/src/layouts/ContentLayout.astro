---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  h1?: string;
  lede?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  datePublished?: string;
  dateModified?: string;
}
const { title, description, eyebrow, h1, lede, jsonLd, datePublished, dateModified } = Astro.props;
const hasHeader = Boolean(eyebrow || h1 || lede);

const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" });
const fmtDate = (iso?: string) => (iso ? dateFmt.format(new Date(`${iso}T00:00:00Z`)) : null);
const publishedDisplay = fmtDate(datePublished);
const modifiedDisplay = fmtDate(dateModified);
const showDates = Boolean(publishedDisplay || modifiedDisplay);
const datesAreSame = datePublished && dateModified && datePublished === dateModified;

// Labels for each known content path. Used to build BreadcrumbList JSON-LD
// so /use-cases/* and /vs/* pages become eligible for Google's breadcrumb
// rich result. Pages outside this map (e.g. 404) skip the breadcrumb.
const PATH_LABELS: Record<string, string> = {
  "/how-it-works": "How it works",
  "/use-cases": "Use cases",
  "/use-cases/parallel-coding": "Parallel coding",
  "/use-cases/distributed-code-review": "Distributed code review",
  "/use-cases/agent-swarms": "Agent swarms",
  "/vs": "Compare",
  "/vs/mcp": "agentalk vs MCP",
  "/vs/autogen": "agentalk vs Autogen",
  "/vs/crewai": "agentalk vs CrewAI",
  "/docs": "Wire protocol",
  "/faq": "FAQ",
  "/about": "About",
};

function buildBreadcrumb(pathname: string, siteUrl: URL): Record<string, unknown> | null {
  const clean = pathname.replace(/\/$/, "") || "/";
  if (!PATH_LABELS[clean]) return null;
  const segments = clean.split("/").filter(Boolean);
  const items: Record<string, unknown>[] = [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", siteUrl).href },
  ];
  let acc = "";
  segments.forEach((seg, i) => {
    acc += `/${seg}`;
    const label = PATH_LABELS[acc];
    if (!label) return;
    items.push({
      "@type": "ListItem",
      position: i + 2,
      name: label,
      item: new URL(acc, siteUrl).href,
    });
  });
  return { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: items };
}

const breadcrumb = Astro.site ? buildBreadcrumb(Astro.url.pathname, Astro.site) : null;
const jsonLdList: Record<string, unknown>[] = jsonLd
  ? Array.isArray(jsonLd) ? [...jsonLd] : [jsonLd]
  : [];
if (breadcrumb) jsonLdList.push(breadcrumb);
const finalJsonLd = jsonLdList.length ? jsonLdList : undefined;
---

<Base title={title} description={description} jsonLd={finalJsonLd}>
  <Nav />
  <main>
    <article class="content">
      {hasHeader && (
        <header class="page-header">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {h1 && <h1>{h1}</h1>}
          {lede && <p class="lede">{lede}</p>}
          {showDates && (
            <p class="page-meta">
              {publishedDisplay && (
                <>Published <time datetime={datePublished}>{publishedDisplay}</time></>
              )}
              {publishedDisplay && modifiedDisplay && !datesAreSame && <span aria-hidden="true"> · </span>}
              {modifiedDisplay && !datesAreSame && (
                <>Updated <time datetime={dateModified}>{modifiedDisplay}</time></>
              )}
            </p>
          )}
        </header>
      )}
      <slot />
    </article>
  </main>
  <Footer />
</Base>

<style is:global>
  .content { max-width: var(--content-w); margin: 0 auto; padding: 2.5rem 1.25rem 1rem; }
  .page-header { margin-bottom: 2.5rem; }
  .eyebrow {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
  }
  .content h1 { max-width: 28ch; }
  .lede { font-size: 1.1rem; color: var(--muted); line-height: 1.55; margin: 1.25rem 0 0; }
  .page-meta {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    font-feature-settings: "tnum";
  }
  .page-meta time { color: var(--text); font-weight: 500; }
  .content h2 { margin-top: 3rem; }
  .content h3 { margin-top: 2rem; }
  .content p, .content li { color: var(--text); }
  .content ul, .content ol { padding-left: 1.4rem; }
  .content li { margin-bottom: 0.4rem; }
  .diagram {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    color: var(--muted);
  }
  .related-links {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  .related-links li {
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
  }
  .related-links a { display: block; color: var(--accent); }
  .related-links a:hover { text-decoration: none; }
  .related-links li:has(a:hover) { border-color: var(--accent); }

  .callout {
    background: var(--accent-soft);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 0.9rem 1.15rem;
    margin: 1.5rem 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .callout strong { color: var(--text); }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .card-grid article {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    transition: border-color 120ms;
  }
  .card-grid article:hover { border-color: var(--accent); }
  .card-grid h3 { color: var(--accent); margin: 0 0 0.5rem; }
  .card-grid p { color: var(--muted); margin: 0 0 0.5rem; font-size: 0.95rem; }
  .card-grid a { font-weight: 500; }

  /* Comparison tables — used by /vs/* pages */
  .compare {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    font-size: 0.95rem;
  }
  .compare thead th {
    background: var(--bg-elevated);
    color: var(--text);
    font-weight: 600;
    font-size: 0.92rem;
    text-align: left;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .compare thead th.col-agentalk { color: var(--accent); }
  .compare tbody td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    color: var(--text);
  }
  .compare tbody tr:last-child td { border-bottom: 0; }
  .compare tbody td:first-child {
    color: var(--muted);
    font-weight: 500;
    width: 30%;
    background: color-mix(in srgb, var(--bg-elevated) 50%, transparent);
  }
  .compare tbody td code { font-size: 0.85em; }
  @media (max-width: 640px) {
    .compare { font-size: 0.88rem; }
    .compare thead th, .compare tbody td { padding: 0.6rem 0.7rem; }
  }
</style>
